{
  "name": "framecritic",
  "version": "0.1.0",
  "description": "FrameCritic — local-first visual QA for AI-built web apps",
  "type": "module",
  "bin": {
    "framecritic": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "scan": "tsx src/cli.ts",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "axe-core": "^4.13.0",
    "playwright": "^1.48.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
