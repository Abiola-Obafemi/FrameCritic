{
  "name": "framecritic",
  "version": "0.2.0",
  "description": "FrameCritic — local-first visual QA for AI-built web apps. No cloud, no AI, no accounts.",
  "type": "module",
  "license": "MIT",
  "author": "Abiola Obafemi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abiola-Obafemi/FrameCritic.git"
  },
  "homepage": "https://github.com/Abiola-Obafemi/FrameCritic#readme",
  "bugs": {
    "url": "https://github.com/Abiola-Obafemi/FrameCritic/issues"
  },
  "keywords": [
    "visual-testing",
    "playwright",
    "developer-tools",
    "ai-agents",
    "quality-assurance",
    "typescript",
    "qa",
    "screenshot",
    "accessibility"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "framecritic": "dist/cli.js"
  },
  "files": [
    "dist/",
    "public/",
    "README.md",
    "LICENSE",
    "!dist/**/*.test.*",
    "!dist/**/*.test.*.map"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "scan": "tsx src/cli.ts",
    "test": "node --test dist/**/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "express": "^4.19.2",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
